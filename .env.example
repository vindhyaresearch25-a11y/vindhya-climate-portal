# Copy this file to .env and set the paths for your machine.
# scripts/config.py reads these; defaults point at ./data (not bundled).

# --- IMD 0.05 deg gridded daily NetCDF (2000-2024) ---
# Expected filenames: INDmet_tmax_05km_{year}.nc, etc.
IMD_TMAX_DIR=./data/imd/tmax
IMD_TMIN_DIR=./data/imd/tmin
IMD_PRECIP_DIR=./data/imd/precip

# --- MP village boundary shapefile (LGD-coded) ---
# Needs columns: District, Vill_LGD, Villl_name, Sub_dist
MP_VILLAGE_SHAPEFILE=./data/boundaries/MADHYA_PRADESH.shp

# --- UNDP DiCRA NDVI export root (NDVI_<year>_<half>/VECTOR/DISTRICT/*.geojson)
DICRA_DIR=./data/dicra

# --- Google Earth Engine project id, for the CMIP6 2040 workflow ---
# scripts/05_gee_cmip6_2040.js is pasted into the GEE code editor, not run here.
GEE_PROJECT_ID=

# --- Gemini key for the dashboard chatbot ---
# Never commit a real key. On Streamlit Cloud set it in Secrets instead;
# on GitHub Pages the chatbot stays disabled because there is no server
# to hold the secret.
GEMINI_API_KEY=
