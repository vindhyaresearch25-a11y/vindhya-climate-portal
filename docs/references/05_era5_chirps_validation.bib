% Topic: ERA5-Land and CHIRPS validation studies for India specifically.
% MOST IMPORTANT topic per FINAL_PROMPT.md Phase 10 -- this portal uses
% ERA5-Land + CHIRPS directly for national (non-MP) districts via
% scripts/08_gee_national_climate.py (METHODOLOGY.md \S7 item 9,
% DATA_SOURCES.md). All DOIs verified via CrossRef API, 2026-08-07.

@article{mahto2019era5,
  author  = {Mahto, Shanti Shwarup and Mishra, Vimal},
  title   = {Does {ERA}-5 Outperform Other Reanalysis Products for
             Hydrologic Applications in {I}ndia?},
  journal = {Journal of Geophysical Research: Atmospheres},
  year    = {2019},
  volume  = {124},
  doi     = {10.1029/2019JD031155},
  note    = {Evaluates ERA-5 (parent reanalysis of ERA5-Land) against 4 other
             reanalysis products and IMD gridded observations for
             precipitation, temperature, runoff, ET and soil moisture over
             India; concludes ERA-5 is the best general-purpose reanalysis for
             Indian hydrologic applications, though CFSR performs better for
             monsoon runoff specifically. Not ERA5-Land-specific (ERA5-Land is
             the higher-resolution land-only replay of the same atmospheric
             forcing), but the closest India-specific, peer-reviewed
             validation of the ERA5 family found.}
}

@article{kumar2025chirpsgsmap,
  author  = {Kumar, Prashant and Gupta, Ujjwal K. and Yamamoto, Munehisa K.
             and Kubota, Takuji},
  title   = {Long-term evaluation of {CHIRPS} and {GSMaP\_ISRO} rainfall
             estimates for {I}ndian summer monsoon (2000--2022)},
  journal = {Remote Sensing Applications: Society and Environment},
  year    = {2025},
  volume  = {39},
  pages   = {101627},
  doi     = {10.1016/j.rsase.2025.101627},
  note    = {23-year CHIRPS evaluation against IMD gauge data over the full
             Indian landmass. Finds GSMaP\_ISRO agrees more closely with gauges
             than CHIRPS; CHIRPS slightly overestimates mean rainfall, with
             the largest divergence over the Western Ghats and northeastern
             India -- consistent with the non-uniform bias METHODOLOGY.md
             \S3.1 already documents from a different (ScienceDirect,
             S2950-1172-2600021X) South Peninsular India study.}
}

@article{kumarv2024twentythree,
  author  = {Kumar, Vivek and Borgemeister, Christian and Tischbein, Bernhard
             and Kumar, Navneet},
  title   = {Evaluation and inter-comparison of twenty-three gridded rainfall
             products representing a typical urban monsoon climate in {I}ndia},
  journal = {Theoretical and Applied Climatology},
  year    = {2024},
  volume  = {155},
  doi     = {10.1007/s00704-024-05191-3},
  note    = {23-product intercomparison for Patna, India, including CHIRPS and
             ERA5-Land among the gridded/reanalysis products evaluated against
             station data -- multi-product context for where CHIRPS/ERA5-Land
             rank among available alternatives for an Indian urban-monsoon
             setting.}
}

@article{paul2024ismr,
  author  = {Paul, Sandipan and Sharma, Priyank J. and Teegavarapu, Ramesh S. V.},
  title   = {Indian Summer Monsoon Rainfall Characteristics Derived From
             Multiple Gridded Precipitation Datasets: A Comparative Assessment},
  journal = {International Journal of Climatology},
  year    = {2024},
  volume  = {45},
  doi     = {10.1002/joc.8708},
  note    = {Benchmarks multiple gridded precipitation products (observational,
             satellite, reanalysis, hybrid -- including CHIRPS-class and
             ERA5-Land-class products) against IMD 0.25\textdegree{} gridded
             data as ground truth for reproducing Indian Summer Monsoon
             Rainfall characteristics.}
}

@article{tanakanti2026southpeninsular,
  author  = {Tanakanti, Vijaya Markandeya and Bharghavi, Kandula and Reddy,
             Thotli Lokeswara and Reddy, Krishnareddigari Krishna},
  title   = {Comparative assessment of {IMD} and {CHIRPS} rainfall products
             over Southern Peninsular {I}ndia: A multi-scale validation study
             (2001--2020)},
  journal = {Evolving Earth},
  year    = {2026},
  volume  = {4},
  pages   = {100125},
  doi     = {10.1016/j.eve.2026.100125},
  note    = {This is the paper already cited in METHODOLOGY.md \S3.1/\S8 as
             "CHIRPS vs IMD validation, South Peninsular India 2001-2020...
             ScienceDirect, record S2950-1172-2600021X" -- confirmed real and
             correctly identified (r=0.888, RMSE=180mm regional correlation,
             non-uniform bias with positive bias on Western Ghats windward
             slopes and near-zero bias in interior semi-arid tracts). One
             cosmetic issue found and worth a follow-up fix: METHODOLOGY.md's
             record ID has spurious dashes ("S2950-1172-2600021X"); the
             correct unhyphenated ScienceDirect PII is S295011722600021X,
             matching DOI 10.1016/j.eve.2026.100125 above. Not a fabrication,
             just a formatting typo -- noted in METHODOLOGY\_REVIEW.md, not
             corrected here per the task's no-edit rule for existing docs.}
}

