% Topic: Heatwave definition -- IMD's criteria vs international (WMO/UK)
% definitions. Used by this portal for: scripts/02_compute_indices.py
% heatwave/severe-heatwave day counting -- METHODOLOGY.md section 4.1.
% DOIs verified via CrossRef API, 2026-08-07.

@article{pai2013longterm,
  author  = {Pai, D. S. and Nair, Smitha Anil and Ramanathan, A. N.},
  title   = {Long term climatology and trends of heat waves over {I}ndia
             during the recent 50 years (1961--2010)},
  journal = {MAUSAM},
  year    = {2013},
  volume  = {64},
  number  = {4},
  pages   = {585--604},
  doi     = {10.54302/mausam.v64i4.742},
  note    = {IMD's own peer-reviewed journal. Sets out and applies the IMD
             absolute + departure-from-normal heatwave criteria
             (METHODOLOGY.md \S4.1 reproduces these thresholds: Tmax
             \textgeq{}40\textdegree{}C plains and departure \textgeq{}4.5-6.5\textdegree{}C, or
             absolute \textgeq{}45/47\textdegree{}C) at national scale, 1961-2010.}
}

@article{rohini2016variability,
  author  = {Rohini, P. and Rajeevan, M. and Srivastava, A. K.},
  title   = {On the Variability and Increasing Trends of Heat Waves over {I}ndia},
  journal = {Scientific Reports},
  year    = {2016},
  volume  = {6},
  pages   = {26153},
  doi     = {10.1038/srep26153},
  note    = {Independent (non-IMD-journal) confirmation of IMD heatwave-day
             counting methodology and its trend results using 1961-2013
             gridded Tmax; also applies the Excess Heat Factor (EHF) and a
             90th-percentile-based definition as points of comparison,
             illustrating that IMD's absolute-threshold approach is one of
             several methodologically distinct definitions in use even within
             the Indian literature.}
}

@article{mccarthy2019ukheatwave,
  author  = {McCarthy, Mark and Armstrong, Lynne and Armstrong, Neil},
  title   = {A new heatwave definition for the {UK}},
  journal = {Weather},
  year    = {2019},
  volume  = {74},
  number  = {11},
  pages   = {382--387},
  doi     = {10.1002/wea.3629},
  note    = {The international-comparison counterpoint to IMD's fixed
             absolute-temperature-plus-departure criteria: the UK Met Office
             definition adopted here is a location-specific 90th-percentile
             threshold over a fixed 3-day (day + 2 following) window, with no
             single national absolute-temperature threshold at all --
             structurally different from IMD's approach and representative of
             the WMO-recommended percentile-based family of definitions
             (WMO Guidelines on the Definition and Characterization of Extreme
             Weather and Climate Events, rcc.dwd.de/DWD-RCC mirror -- grey
             literature, not included as a BibTeX entry since it is a WMO
             technical guideline document, not a peer-reviewed journal
             article, per the task's peer-review requirement).}
}
