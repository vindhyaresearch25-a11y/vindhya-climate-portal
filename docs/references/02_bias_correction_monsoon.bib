% Topic: Bias correction (quantile mapping / delta change) for CMIP6 over
% India's monsoon domain, and the delta-change convention itself.
% Relevant to METHODOLOGY.md section 5 ("delta is the meaningful number")
% and section 7 item 5 ("No bias correction beyond what NEX-GDDP applies").
% All DOIs verified via CrossRef API, 2026-08-07.

@article{cannon2015quantilemapping,
  author  = {Cannon, Alex J. and Sobie, Stephen R. and Murdock, Trevor Q.},
  title   = {Bias Correction of {GCM} Precipitation by Quantile Mapping:
             How Well Do Methods Preserve Changes in Quantiles and Extremes?},
  journal = {Journal of Climate},
  year    = {2015},
  volume  = {28},
  number  = {17},
  pages   = {6938--6959},
  doi     = {10.1175/JCLI-D-14-00754.1},
  note    = {Foundational quantile-mapping method-comparison paper (not India-specific).
             Shows standard (non-detrended) quantile mapping can degrade a
             model's projected trend in the tails -- the caveat behind this
             portal's choice to report future-minus-baseline delta (same model,
             same bias) rather than apply post-hoc quantile mapping to absolute
             NEX-GDDP output (METHODOLOGY.md \S5, \S7 item 5).}
}

