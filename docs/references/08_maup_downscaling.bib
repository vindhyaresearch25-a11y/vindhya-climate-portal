% Topic: Village-level / sub-district downscaling limitations -- the
% Modifiable Areal Unit Problem (MAUP). Used by this portal for:
% METHODOLOGY.md section 3.1 (spatial resolution / MAUP discussion) and
% section 7 item 1. DOIs verified via CrossRef API where they exist;
% Openshaw & Taylor 1979 predates the DOI system and is verified instead via
% its Semantic Scholar record (989 citations) and multiple independent
% secondary citations, 2026-08-07.

@incollection{openshaw1979million,
  author    = {Openshaw, Stan and Taylor, Peter J.},
  title     = {A million or so correlation coefficients: three experiments
               on the modifiable areal unit problem},
  booktitle = {Statistical Applications in the Spatial Sciences},
  editor    = {Wrigley, N.},
  year      = {1979},
  publisher = {Pion},
  address   = {London},
  pages     = {127--144},
  note      = {The paper that coined "Modifiable Areal Unit Problem" (MAUP) --
               no DOI exists (1979, pre-DOI-era edited volume). Verified as a
               real, extant, heavily-cited (989 citations, Semantic Scholar)
               work via independent secondary confirmation (Fotheringham \&
               Wong 1991 below; multiple current MAUP review articles cite it
               identically). Demonstrates that statistical results computed
               over arbitrary areal units can be driven to either extreme by
               the choice of unit boundaries -- the general form of the
               problem METHODOLOGY.md \S3.1 names when explaining why a grid
               cell's value is reported for every village whose centroid falls
               in it, rather than treated as a village-specific measurement.}
}

@article{fotheringham1991maup,
  author  = {Fotheringham, A. Stewart and Wong, David W. S.},
  title   = {The Modifiable Areal Unit Problem in Multivariate Statistical
             Analysis},
  journal = {Environment and Planning A: Economy and Space},
  year    = {1991},
  volume  = {23},
  number  = {7},
  pages   = {1025--1044},
  doi     = {10.1068/a231025},
  note    = {Extends MAUP from the univariate/bivariate case (Openshaw \&
             Taylor 1979) to multivariate statistical models, showing
             regression coefficients themselves are sensitive to the zoning
             scheme -- relevant beyond this portal's simple per-district means
             to the composite risk-classification scoring in METHODOLOGY.md
             \S6, which sums thresholded indicators computed at the same
             grid-cell-per-district resolution.}
}

@article{barik2024india,
  author  = {Barik, Anasuya and Sahoo, Sanjeeb Kumar and Kumari, Sarita and
             Baidya Roy, Somnath},
  title   = {High-resolution climate projection dataset over {I}ndia using
             dynamical downscaling},
  journal = {Geoscience Data Journal},
  year    = {2024},
  doi     = {10.1002/gdj3.266},
  note    = {Already cited in METHODOLOGY.md \S3.1/\S8; reproduced here with
             the exact verified title (Semantic Scholar + CrossRef agree:
             "High-resolution climate projection dataset over India using
             dynamical downscaling" -- METHODOLOGY.md currently paraphrases
             this as "A high-resolution dynamically downscaled climate
             dataset for India", a minor title mismatch worth a follow-up
             citation fix, noted in METHODOLOGY\_REVIEW.md). India's own
             national dynamical-downscaling effort settled on 10 km as the
             practically achievable scale -- the paper this portal's "no
             product resolves true village scale" argument rests on.}
}
